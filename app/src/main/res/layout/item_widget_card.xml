<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/rounded_widget_card"
    android:clipChildren="true"
    android:clipToOutline="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/widgetViewport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="true"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/widgetBody"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <View
            android:id="@+id/widgetManageOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/dialogShadeColor"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widgetResizeHandle"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:contentDescription="@string/resize_widget"
        android:visibility="gone">

        <View
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_resize_handle" />
    </FrameLayout>
</LinearLayout>
