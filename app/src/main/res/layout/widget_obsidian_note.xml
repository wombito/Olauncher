<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/noteHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/noteTitle"
            style="@style/TextSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="18sp"
            tools:text="My Note" />

        <TextView
            android:id="@+id/noteChange"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:text="@string/change_note" />
    </LinearLayout>

    <app.olauncher.ui.widgets.WidgetScrollView
        android:id="@+id/noteScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <TextView
            android:id="@+id/noteBody"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.1"
            tools:text="# Heading\n\nBody text" />
    </app.olauncher.ui.widgets.WidgetScrollView>

    <TextView
        android:id="@+id/notePick"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/pick_note"
        android:visibility="gone" />

    <TextView
        android:id="@+id/noteError"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.5"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/note_read_error"
        android:visibility="gone" />
</LinearLayout>
